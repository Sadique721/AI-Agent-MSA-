# ╔════════════════════════════════════════════════════════════════════════════╗
# ║  MSA Config & Feature Flag Service — Slim Dockerfile                       ║
# ║  Uses requirements.config.txt (Flask only, ~15s build)                     ║
# ║  Module: config-service/config_service.py (Flask app on port 8083)         ║
# ║                                                                              ║
# ║  Endpoints:                                                                  ║
# ║    GET  /health                    → Service health                         ║
# ║    GET  /api/v1/config/<env>       → Environment config                    ║
# ║    GET  /api/v1/flags              → All feature flags                      ║
# ║    POST /api/v1/flags/eval         → Evaluate a feature flag                ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Stage 1: Builder stage
FROM python:3.11-slim-bookworm AS builder

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Slim requirements: Flask only (no torch/CUDA/ML packages)
COPY requirements.config.txt .
# Install to /usr/local (system-wide) so non-root configuser can access
RUN pip install --no-cache-dir --prefix=/usr/local -r requirements.config.txt

# Stage 2: Final runtime stage
FROM python:3.11-slim-bookworm

WORKDIR /app

# Copy installed packages (accessible to all users)
COPY --from=builder /usr/local /usr/local
# Copy only the required modules (config-service + infrastructure shared)
COPY config-service/ ./config-service/
COPY infrastructure/service_registry.py ./infrastructure/service_registry.py
COPY infrastructure/__init__.py ./infrastructure/__init__.py

# SECURITY: Run as non-root user
RUN groupadd -r configuser && useradd -r -g configuser configuser \
    && chown -R configuser:configuser /app

USER configuser

EXPOSE 8083

HEALTHCHECK --interval=20s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8083/health', timeout=2)" || exit 1

# Run the Flask config service directly
ENTRYPOINT ["python", "config-service/config_service.py"]
