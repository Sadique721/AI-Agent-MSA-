# ╔════════════════════════════════════════════════════════════════════════════╗
# ║  MSA Auth Service — Slim Dockerfile                                        ║
# ║  Uses requirements.auth.txt (Flask only, ~30s build)                       ║
# ║  vs requirements.txt (full CUDA stack, ~30min build)                       ║
# ║                                                                              ║
# ║  FIX: --prefix=/usr/local so packages are accessible by non-root user      ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Stage 1: Builder stage
FROM python:3.11-slim-bookworm AS builder

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Slim requirements: only Flask + cryptography (no torch/CUDA/ML packages)
COPY requirements.auth.txt .
# FIX: Install to /usr/local (system-wide) instead of /root/.local (user-home)
# so the non-root authuser can access packages at runtime
RUN pip install --no-cache-dir --prefix=/usr/local -r requirements.auth.txt

# Stage 2: Final runtime stage (Bookworm — Bullseye EOL Aug 2026)
FROM python:3.11-slim-bookworm

WORKDIR /app

# FIX: Copy from /usr/local (accessible to all users, including non-root authuser)
COPY --from=builder /usr/local /usr/local
COPY . .

# SECURITY: Run as non-root user
RUN groupadd -r authuser && useradd -r -g authuser authuser \
    && chown -R authuser:authuser /app

USER authuser

EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8081/health', timeout=2)" || exit 1

ENTRYPOINT ["python", "auth/auth_server.py"]
