{
  "name": "msa-agent-desktop-client",
  "version": "6.0.0",
  "description": "MSA AI Agent V6.0 — Ultimate Career OS Desktop Application",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "concurrently \"vite --port 3000\" \"electron .\"",
    "vite:dev": "vite",
    "electron:dev": "electron .",
    "build": "vite build",
    "build:electron": "npm run build && electron-builder",
    "build:exe": "npm run build && electron-builder --win portable",
    "preview": "vite preview",
    "start": "npm run dev"
  },
  "keywords": [
    "ai",
    "desktop",
    "electron",
    "agent",
    "msa"
  ],
  "author": "Md Sadique Amin",
  "license": "MIT",
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "dompurify": "^3.1.0",
    "framer-motion": "^11.0.0",
    "highlight.js": "^11.9.0",
    "lucide-react": "^0.400.0",
    "marked": "^12.0.0",
    "mermaid": "^11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.5.0",
    "react-textarea-autosize": "^8.5.3",
    "socket.io-client": "^4.7.5",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^5.3.0"
  },
  "build": {
    "appId": "com.msa.aiagent",
    "productName": "MSA AI Agent",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
