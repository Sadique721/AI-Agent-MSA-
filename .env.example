# ╔══════════════════════════════════════════════════════════════════════════╗
# ║         MSA AI Agent V6.0 — Environment Variables (.env.example)         ║
# ║         Copy this file to .env and fill in ALL real values               ║
# ║         NEVER commit .env with real secrets to git!                      ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── MSA Core Secrets ──────────────────────────────────────────────────────────
MSA_SECRET_KEY=msa-secret-key-CHANGE-THIS-IN-PRODUCTION-use-openssl-rand-hex-32
MSA_API_KEY=msa-api-key-CHANGE-THIS-IN-PRODUCTION

# ── User Identity (PII — never hardcode in source code) ─────────────────────
MSA_USER_NAME=Your Name
MSA_USER_EMAIL=your.email@example.com
MSA_USER_PHONE=+91 0000000000

# ── Auth Service Credentials (SHA-256 hashed passwords) ──────────────────────
# Generate: python -c "import hashlib; print(hashlib.sha256('yourpassword'.encode()).hexdigest())"
USER_ADMIN_HASH=CHANGE-ME-SHA256-HASH-OF-ADMIN-PASSWORD
USER_DEV_HASH=CHANGE-ME-SHA256-HASH-OF-DEV-PASSWORD

# ── Internal Service URLs (for Docker inter-container communication) ──────────
BACKEND_URL=http://msa-agent:5000
AUTH_SERVER_URL=http://msa-auth:8081

# ── Ollama LLM (runs on HOST machine, NOT in Docker) ─────────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
MSA_OLLAMA_MODEL=qwen2.5:7b-instruct
MSA_OLLAMA_FAST_MODEL=qwen2.5:0.5b
MSA_OLLAMA_REASON_MODEL=deepseek-r1:7b
MSA_OLLAMA_EMBED_MODEL=nomic-embed-text:latest
MSA_OLLAMA_TIMEOUT=120

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE-ME-STRONG-DB-PASSWORD

# ── Neo4j Graph RAG ───────────────────────────────────────────────────────────
NEO4J_PASSWORD=CHANGE-ME-NEO4J-PASSWORD

# ── HashiCorp Vault ───────────────────────────────────────────────────────────
VAULT_ROOT_TOKEN=CHANGE-ME-VAULT-ROOT-TOKEN

# ── MinIO Object Storage ──────────────────────────────────────────────────────
MINIO_USER=msa_minio_user
MINIO_PASSWORD=CHANGE-ME-MINIO-PASSWORD

# ── Grafana Dashboard ─────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE-ME-GRAFANA-PASSWORD

# ── Telegram Bot (for notifications) ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
N8N_TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# ── SMTP (for email notifications) ────────────────────────────────────────────
SMTP_USER=your-smtp-email@gmail.com
SMTP_PASS=your-smtp-app-password

# ── Optional: Gemini API (cloud LLM fallback) ─────────────────────────────────
# GEMINI_API_KEY=your-gemini-api-key-here

# ── Career / Job Discovery APIs ───────────────────────────────────────────────
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_API_KEY=your-adzuna-api-key
JOOBLE_API_KEY=your-jooble-api-key
JSEARCH_API_KEY=your-jsearch-api-key

# ── Safety: Auto-Apply (keep false unless tested!) ────────────────────────────
MSA_AUTO_APPLY=false
MSA_MAX_APPLY_PER_DAY=20

# ── Frontend Dev (Vite proxy target) ─────────────────────────────────────────
VITE_API_URL=http://localhost:5000
VITE_FASTAPI_URL=http://localhost:8000

# ── N8N Automation ────────────────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE-ME-N8N-PASSWORD
