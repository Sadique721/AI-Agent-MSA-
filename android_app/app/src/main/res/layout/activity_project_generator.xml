<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Project Generator"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/et_project_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Project Name (e.g. msa-todo)"
            android:textColorHint="#888888"
            android:textColor="#FFFFFF"
            android:background="#1E1E1E"
            android:padding="12dp"
            android:inputType="textPersonName"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/et_project_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Project Type (springboot, angular, react)"
            android:textColorHint="#888888"
            android:textColor="#FFFFFF"
            android:background="#1E1E1E"
            android:padding="12dp"
            android:inputType="textFilter"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/et_project_desc"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Description / Requirements..."
            android:textColorHint="#888888"
            android:textColor="#FFFFFF"
            android:background="#1E1E1E"
            android:gravity="top|left"
            android:padding="12dp"
            android:inputType="textMultiLine"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btn_generate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generate Project"
            android:textColor="#FFFFFF"
            android:backgroundTint="#00B0FF"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tv_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00B0FF"
            android:textSize="16sp"
            android:background="#1E1E1E"
            android:padding="12dp"
            android:text="Boilerplate files will list here..." />

    </LinearLayout>
</ScrollView>
